{
  "name": "URL Uploader Bot",
  "description": "Telegram URL uploader bot.",
  "logo": "",
  "keywords": [
    "telegram",
    "yt-dlp",
    "downloader",
    "ffmpeg",
    "remote",
    "uploader"
  ],
  "website": "",
  "repository": "https://github.com/Telebotfaroff/URL-uploader",
  "env": {
    "WEBHOOK": {
      "description": "Setting this to ANYTHING will enable webhooks when in env mode",
      "value": "ANYTHING"
    },
    "BOT_TOKEN": {
      "description": "Your bot token, as a string.",
      "value": ""
    },
    "API_ID": {
      "description": "Get this value from https://my.telegram.org",
      "value": ""
    },
    "API_HASH": {
      "description": "Get this value from https://my.telegram.org",
      "value": ""
    },
    "DATABASE_URL": {
      "description": "Your MongoDB connection URL.",
      "value": ""
    },
    "LOG_CHANNEL": {
      "description": "Your private log channel ID where the bot has admin permissions.",
      "value": ""
    },
    "UPDATES_CHANNEL": {
      "description": "Your updates channel ID for force-subscription.",
      "value": ""
    },
    "OWNER_ID": {
      "description": "Your Telegram user ID for admin actions.",
      "value": ""
    },
    "BOT_USERNAME": {
      "description": "Your bot username without @.",
      "value": ""
    },
    "TRUE_OR_FALSE": {
      "description": "Set False to disable shortlink verification or True to enable it.",
      "value": "False"
    },
    "SHORT_DOMAIN": {
      "description": "Your shortlink domain, for example shortlink.com.",
      "value": ""
    },
    "SHORT_API": {
      "description": "Your shortlink API key.",
      "value": ""
    },
    "VERIFICATION": {
      "description": "Your verification tutorial URL.",
      "value": ""
    },
    "ADMIN": {
      "description": "Optional list of administrator user IDs.",
      "required": false,
      "value": ""
    },
    "BANNED_USERS": {
      "description": "Optional list of user IDs blocked from using the bot.",
      "required": false,
      "value": ""
    }
  },
  "addons": [],
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-activestorage-preview"
    },
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
